# Postgres (docker compose up -d)
DATABASE_URL="postgresql://intelligixl:intelligixl@localhost:5432/intelligixl?schema=public"

# Redis (docker compose up -d) — used for the Smart Column generation job queue
REDIS_URL="redis://localhost:6379"

# TypeSafe AI (Jev). Get a key at https://console.typesafe.ai
# Optional here: you can instead add it on the Settings page. If set, this
# value takes precedence and the Settings page shows it as read-only.
TYPESAFE_API_KEY=""

# Encryption key for secrets saved on the Settings page. If unset, a random
# key is generated at .data/app-secret. Set it explicitly in production:
#   openssl rand -base64 32
# APP_SECRET=""

# Where uploaded datasets and generated exports are written on disk.
# Swap the storage adapter (src/lib/storage) for an S3-compatible client in production.
LOCAL_STORAGE_DIR=".data/storage"

# Laya (optional) — open-weights System One engine, self-hosted via laya-serve
# (github.com/NandhaKishorM/laya). It speaks the same /v1/systemone protocol as Jev.
#   pip install "laya[serve]" && LAYA_PORT=8000 laya-serve
# Can also be set on the Settings page.
#   make laya    # runs it in Docker on :8000
# LAYA_BASE_URL="http://localhost:8000"
# LAYA_API_KEY=""           # only if laya-serve was started with LAYA_API_KEY

# Docker only (make docker-up): Laya URL as seen from inside the containers.
# DOCKER_LAYA_BASE_URL="http://laya:8000"
