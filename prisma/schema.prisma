// IntelligiXL data model.
// Auth is intentionally out of scope (see project decision): a single seeded
// User exists purely so Workspace.ownerId / Review.reviewerId have a stable
// owner for provenance and auditability (NFR-014), not to gate access.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DatasetFormat {
  CSV
  XLSX
  JSON
  JSONL
}

enum DatasetStatus {
  VALIDATING
  READY
  FAILED
}

enum ColumnDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  JSON
}

enum SmartColumnType {
  BINARY
  CATEGORICAL
  RATING
}

enum PredictionStatus {
  PENDING
  SUCCESS
  FAILED
  NOT_PROCESSED
}

// Mirrors AIR-006 provider error states, collapsed to what the UI needs to branch on.
enum PredictionErrorReason {
  EMPTY_SOURCE
  TIMEOUT
  RATE_LIMITED
  PROVIDER_UNAVAILABLE
  INVALID_RESPONSE
  AUTH_FAILURE
  UNKNOWN
}

enum ReviewStatus {
  NOT_REVIEWED
  CONFIRMED
  CORRECTED
  SKIPPED
}

enum JobType {
  SMART_COLUMN_GENERATION
  SMART_COLUMN_RETRY
  EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExportFormat {
  CSV
  XLSX
}

// One entry per data-mutating action (not per AI generation run — those are
// Job/logs). A dataset-scoped linear undo/redo stack: `undone` marks entries
// that have been undone, ordered by createdAt within a dataset. Undoing pops
// the newest `undone: false` entry; redoing pops the newest `undone: true`
// one; any *new* action first deletes every `undone: true` entry for that
// dataset (the classic "redo stack is invalidated by a fresh edit" rule).
enum ChangeLogAction {
  CELL_EDIT
  ROW_INSERT
  ROW_DELETE
  COLUMN_INSERT
  COLUMN_DELETE
  COLUMN_RENAME
  COLUMN_DUPLICATE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  workspaces Workspace[]
  reviews    Review[]
}

model Workspace {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  description String?
  // Which activity-log categories this workspace records, as
  // { [category]: boolean } — see src/lib/activity/categories.ts. null or a
  // missing key = that category's default (on).
  activitySettings Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activityLogs ActivityLog[]
  datasets     Dataset[]
  smartColumns SmartColumn[]
  jobs         Job[]
  templates    Template[]
  studyEvents  StudyEvent[]
  exports      ExportRecord[]

  @@index([ownerId])
}

model Dataset {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename       String
  originalFormat DatasetFormat
  rowCount       Int           @default(0)
  columnCount    Int           @default(0)
  storageKey     String
  status         DatasetStatus @default(VALIDATING)
  warning        String?
  createdAt      DateTime      @default(now())

  columns      DatasetColumn[]
  rows         DatasetRow[]
  smartColumns SmartColumn[]
  exports      ExportRecord[]
  jobs         Job[]
  changeLogs   DatasetChangeLog[]

  @@index([workspaceId])
}

// Enough of a before/after snapshot per action to invert or replay it —
// see ChangeLogAction. `before`/`after` shapes are action-specific (see
// src/lib/change-log.ts), not modeled in SQL since they're never queried on.
model DatasetChangeLog {
  id        String          @id @default(cuid())
  datasetId String
  dataset   Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  action    ChangeLogAction
  summary   String
  before    Json?
  after     Json?
  undone    Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([datasetId, createdAt])
}

model DatasetColumn {
  id       String         @id @default(cuid())
  datasetId String
  dataset  Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name     String
  dataType ColumnDataType
  position Int
  isSource Boolean        @default(true)

  @@unique([datasetId, name])
  @@index([datasetId])
}

model DatasetRow {
  id        String  @id @default(cuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rowIndex  Int
  data      Json

  predictions Prediction[]

  @@unique([datasetId, rowIndex])
  @@index([datasetId])
}

model SmartColumn {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasetId       String
  dataset         Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name            String
  type            SmartColumnType
  activeVersionId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  versions SmartColumnVersion[] @relation("SmartColumnVersions")
  jobs     Job[]

  @@unique([datasetId, name])
  @@index([workspaceId])
}

// A new row is created here (not an update-in-place) whenever a Smart
// Column's question/instructions/labels/source columns change — see FR-040.
model SmartColumnVersion {
  id              String   @id @default(cuid())
  smartColumnId   String
  smartColumn     SmartColumn @relation("SmartColumnVersions", fields: [smartColumnId], references: [id], onDelete: Cascade)
  versionNumber   Int
  question        String
  instructions    String?
  sourceColumns   String[]
  // BINARY: { yes: string|null, no: string|null }
  // CATEGORICAL: { [option: string]: string|null }
  // RATING: string[] (ordered levels, low -> high)
  labels          Json
  unclearEnabled  Boolean  @default(false)
  modelProvider   String   @default("typesafe")
  modelIdentifier String   @default("jev-latest")
  // Per-run settings (confidence threshold, concurrency, timeout, retries),
  // see src/lib/decision-models/catalog.ts. null = defaults.
  settings        Json?
  createdAt       DateTime @default(now())

  predictions Prediction[]
  jobs        Job[]

  @@unique([smartColumnId, versionNumber])
  @@index([smartColumnId])
}

model Prediction {
  id                   String                 @id @default(cuid())
  datasetRowId         String
  datasetRow           DatasetRow             @relation(fields: [datasetRowId], references: [id], onDelete: Cascade)
  smartColumnVersionId String
  smartColumnVersion   SmartColumnVersion     @relation(fields: [smartColumnVersionId], references: [id], onDelete: Cascade)
  // The job run that most recently wrote this row — lets the Jobs/Logs view
  // attribute a failure to the exact run that produced it, even after a
  // later run overwrites the same row.
  jobId                String?
  job                  Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status               PredictionStatus       @default(PENDING)
  errorReason          PredictionErrorReason?
  predictedLabel       String?
  confidence           Float?
  // Choice: { [option]: number }. Rating: { [levelIndex as string]: number }.
  probabilities        Json?
  // Rating only — the probability-weighted score, can land between levels.
  score                Float?
  // Rating only — level index (as string) -> level description.
  legend               Json?
  modelVersion         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  review Review?

  @@unique([datasetRowId, smartColumnVersionId])
  @@index([smartColumnVersionId, status])
  @@index([smartColumnVersionId, confidence])
  @@index([smartColumnVersionId, predictedLabel])
  @@index([jobId, status])
}

// The AI prediction above is never overwritten by a human correction — the
// original stays intact and the human value lives here (§19 core principle).
model Review {
  id           String       @id @default(cuid())
  predictionId String       @unique
  prediction   Prediction   @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  reviewedValue String?
  status       ReviewStatus @default(NOT_REVIEWED)
  reviewerId   String?
  reviewer     User?        @relation(fields: [reviewerId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

model Job {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobType              JobType
  status               JobStatus @default(QUEUED)
  totalItems           Int       @default(0)
  completedItems       Int       @default(0)
  failedItems          Int       @default(0)
  datasetId            String?
  dataset              Dataset?  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  smartColumnId        String?
  smartColumn          SmartColumn?        @relation(fields: [smartColumnId], references: [id], onDelete: Cascade)
  smartColumnVersionId String?
  smartColumnVersion   SmartColumnVersion? @relation(fields: [smartColumnVersionId], references: [id], onDelete: Cascade)
  errorLog             Json?
  // Ring-buffered, timestamped run log for the Logs view — [{ ts, level, message }],
  // capped in-process to the most recent entries (see runGenerationJob).
  logs                 Json?
  createdAt            DateTime  @default(now())
  finishedAt           DateTime?

  predictions Prediction[]

  @@index([workspaceId])
  @@index([smartColumnVersionId])
}

model Template {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Reusable SmartColumn definition: { type, question, instructions, labels, sourceColumnHints }
  config      Json
  isBuiltIn   Boolean  @default(false)
  category    String?
  tags        String[] @default([])
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model StudyEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())

  @@index([workspaceId, eventType])
}

model ExportRecord {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasetId   String
  dataset     Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  format      ExportFormat
  fields      Json
  storageKey  String
  createdAt   DateTime     @default(now())

  @@index([workspaceId])
}

// Workspace-scoped audit trail of user actions (never navigation) — see
// src/lib/activity. `datasetId` deliberately has no FK and `datasetName` is
// copied in, so an entry still reads correctly after its dataset is deleted.
model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    String
  action      String
  summary     String
  datasetId   String?
  datasetName String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, category, createdAt])
}

// App-wide configuration editable from the Settings page (API keys, provider
// URLs). Environment variables with the same key always take precedence.
// Secret values are AES-256-GCM encrypted (see src/lib/settings/crypto.ts).
model AppSetting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
